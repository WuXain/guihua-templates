{
  "$schema": "https://json.schemastore.org/template",
  "author": "Charles.Yu",
  "classifications": ["Console", "Tools", "Diagnostics"],
  "identity": "Guihua.Templates.Tool.CSharp",
  "name": "YOU Console Tool Template",
  "description": "A safe, configurable .NET console tool with structured logging and graceful cancellation.",
  "shortName": "guihua-tool",
  "sourceName": "YOU",
  "groupIdentity": "Guihua.Templates.Tool",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "sources": [
    {
      "source": "content",
      "target": "./",
      "modifiers": [
        {
          "exclude": ["_rels/**", "package/**", "**/*Content_Types*.xml", "**/*.nuspec", "**/*.nupkg"]
        }
      ]
    }
  ],
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "displayName": "Target framework",
      "description": "The single target framework for the generated tool.",
      "choices": [
        { "choice": "net8.0", "description": ".NET 8 (default compatibility channel)" },
        { "choice": "net10.0", "description": ".NET 10" }
      ],
      "defaultValue": "net8.0",
      "replaces": "__GUIHUA_TARGET_FRAMEWORK__"
    },
    "sdkVersion": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__GUIHUA_SDK_VERSION__",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          { "condition": "(framework == 'net8.0')", "value": "8.0.423" },
          { "condition": "(framework == 'net10.0')", "value": "10.0.302" }
        ]
      }
    }
  },
  "primaryOutputs": [{ "path": "YOU.sln" }]
}
